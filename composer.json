{
	"name": "arnoldwender/wm-cra-sbom-beacon",
	"description": "CycloneDX 1.6 software inventory, RFC 9116 security.txt and CSAF 2.0 base advisory beacon for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
	},
	"autoload": {
		"psr-4": {
			"WMCyber\\CRA\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"WMCyber\\CRA\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"sort-packages": true
	}
}
