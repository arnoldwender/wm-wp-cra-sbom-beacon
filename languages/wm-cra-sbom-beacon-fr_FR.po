msgid "CRA Beacon Status"
msgstr "État CRA Beacon"

#: includes/Frontend/PsirtPortal.php:100
msgid "Berechneter Status der ausgelieferten security.txt (RFC 9116)."
msgstr "État calculé du fichier security.txt servi (RFC 9116)."

#: includes/Frontend/PsirtPortal.php:178
msgid "Sicherheitshinweise und Meldung von Schwachstellen"
msgstr "Avis de sécurité et signalement de vulnérabilités"

#: includes/Frontend/PsirtPortal.php:181
msgid ""
"Schwachstellen in dieser Website melden Sie an die unten genannte Adresse. "
"Die Liste der eingesetzten Software und die veröffentlichten "
"Sicherheitshinweise stehen als JSON bereit."
msgstr ""
"Signalez toute vulnérabilité de ce site à l’adresse ci-dessous. L’inventaire "
"logiciel et les avis de sécurité publiés sont disponibles en JSON."

#: includes/Frontend/PsirtPortal.php:187
msgid "Kontakt für Sicherheitsmeldungen"
msgstr "Contact pour les signalements de sécurité"

#: includes/Frontend/PsirtPortal.php:189
msgid "Nicht hinterlegt"
msgstr "Non renseigné"

#: includes/Frontend/PsirtPortal.php:194
msgid "Software-Liste (CycloneDX 1.6)"
msgstr "Inventaire logiciel (CycloneDX 1.6)"

#: includes/Frontend/PsirtPortal.php:198
